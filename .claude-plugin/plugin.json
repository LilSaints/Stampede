{
  "name": "stampede",
  "version": "1.0.0-rc.8",
  "description": "Run deterministic workflows over communicating Claude Code and Codex workers.",
  "author": {
    "name": "Marco Santini"
  },
  "types": "./types/index.d.ts",
  "mcpServers": {
    "stampede": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.js", "mcp", "--role", "orchestrator"],
      "env": { "STAMPEDE_PLUGIN_HOME": "${user_config.stampedeHome}" }
    }
  },
  "userConfig": {
    "stampedeHome": {
      "type": "string",
      "title": "Stampede home",
      "description": "Stampede state directory (default ~/.stampede)",
      "required": false
    }
  }
}
