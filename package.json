{
  "name": "stampede",
  "version": "1.0.0-rc.13",
  "private": true,
  "description": "Deterministic local multi-agent workflows for Claude Code and Codex",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stampede": "dist/cli.js"
